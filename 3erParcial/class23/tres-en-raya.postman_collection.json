{
  "info": {
    "name": "Tres en Raya - class23",
    "description": "Backend Express + minimax. Levantar antes:\n- backend:  npm run dev  (puerto 3000)\n- front:    npm run dev  (puerto 5173, solo para el request del proxy)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base",
      "value": "http://localhost:3000"
    },
    {
      "key": "front",
      "value": "http://localhost:5173"
    }
  ],
  "item": [
    {
      "name": "1. GET /saludo (devuelve JSON)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"responde 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test(\"el Content-Type es JSON\", function () {",
              "  pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
              "});",
              "pm.test(\"trae el mensaje\", function () {",
              "  pm.expect(pm.response.json().message).to.eql(\"Hola como json\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base}}/saludo",
          "host": [
            "{{base}}"
          ],
          "path": [
            "saludo"
          ]
        }
      }
    },
    {
      "name": "2. POST /api/jugar - tapa la diagonal (el ejemplo del pizarron)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"responde 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test(\"la IA tapa en la casilla 8\", function () {",
              "  pm.expect(pm.response.json().indice).to.eql(8);",
              "});",
              "pm.test(\"la partida sigue\", function () {",
              "  pm.expect(pm.response.json().estado).to.eql(\"en_curso\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tablero\": [\n    \"X\",\n    null,\n    \"O\",\n    null,\n    \"X\",\n    null,\n    null,\n    null,\n    null\n  ],\n  \"turno\": \"O\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base}}/api/jugar",
          "host": [
            "{{base}}"
          ],
          "path": [
            "api",
            "jugar"
          ]
        }
      }
    },
    {
      "name": "3. POST /api/jugar - la IA gana cerrando linea",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"juega en la casilla 2\", function () {",
              "  pm.expect(pm.response.json().indice).to.eql(2);",
              "});",
              "pm.test(\"gana O\", function () {",
              "  pm.expect(pm.response.json().estado).to.eql(\"ganado\");",
              "  pm.expect(pm.response.json().ganador).to.eql(\"O\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tablero\": [\n    \"O\",\n    \"O\",\n    null,\n    \"X\",\n    \"X\",\n    null,\n    null,\n    null,\n    null\n  ],\n  \"turno\": \"O\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base}}/api/jugar",
          "host": [
            "{{base}}"
          ],
          "path": [
            "api",
            "jugar"
          ]
        }
      }
    },
