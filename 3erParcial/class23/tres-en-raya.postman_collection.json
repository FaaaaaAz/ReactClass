    {
      "name": "7. POST por el PROXY de Vite (:5173) - demuestra que no hace falta CORS",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"el proxy reenvia al backend\", function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().indice).to.eql(8);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tablero\": [\n    \"X\",\n    null,\n    \"O\",\n    null,\n    \"X\",\n    null,\n    null,\n    null,\n    null\n  ],\n  \"turno\": \"O\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
